# ==============================================================================
# Hostel Management System - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your local credentials.
# NEVER commit your real .env file with active secrets to version control.
# ==============================================================================

NODE_ENV=development
PORT=5000

# MongoDB Database Connection URI
# Local: mongodb://127.0.0.1:27017/hostel_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hostel_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hostel_management_system?retryWrites=true&w=majority

# JWT Authentication Secret (Minimum 32 characters random string)
JWT_SECRET=your_32_character_minimum_random_secret_string_here
JWT_EXPIRE=30d

# Base URLs
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Student Email Verification Policy (Set to false for local dev)
REQUIRE_EMAIL_VERIFICATION=false

# Email Service Configuration (ethereal | smtp | brevo)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
MAIL_FROM=Hostel Management System <noreply@your-verified-domain.com>
MAIL_FROM_NAME="Hostel Management System"
