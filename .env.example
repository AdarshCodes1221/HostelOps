# ==============================================================================
# Hostel Management System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your local credentials.
# NEVER commit your real .env file with active secrets to version control.
# ==============================================================================

# Application Environment & Port
# Render dynamically sets PORT; defaults to 5000 locally
NODE_ENV=development
PORT=5000

# MongoDB Database Connection URI (MongoDB Atlas or local instance)
# Local: mongodb://127.0.0.1:27017/hostel_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hostel_management_system?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hostel_management_system?retryWrites=true&w=majority

# JWT Authentication Secret (Minimum 32 characters cryptographically secure random string)
JWT_SECRET=your_32_character_minimum_random_secret_string_here
JWT_EXPIRE=30d

# Base URLs & CORS Configuration (Render Backend, Netlify Frontend, or Local Docker)
# Local Docker Frontend runs on port 8081 (leaving port 8080 reserved for Jenkins)
APP_BASE_URL=http://localhost:8081
FRONTEND_URL=http://localhost:8081
ALLOWED_ORIGINS=https://your-hms-app.netlify.app

# Student Email Verification Policy (Set to false for local dev / testing)
REQUIRE_EMAIL_VERIFICATION=false

# ==============================================================================
# Email Service Configuration
# ==============================================================================
# Supported EMAIL_PROVIDER options:
# 1. 'brevo_api' - Brevo HTTPS REST API (Recommended for Render Free where SMTP ports 25, 465, 587 are blocked)
# 2. 'smtp'      - Standard SMTP (requires unblocked outbound SMTP ports)
# 3. 'resend'    - Resend transactional SMTP
# 4. 'ethereal'  - Zero-config disposable test inbox for local development

EMAIL_PROVIDER=brevo_api

# Brevo HTTPS REST API Configuration (For Render Free / Serverless)
# NOTE: Use your regular Brevo v3 API key (starts with 'xkeysib-'), NOT an SMTP key ('xsmtpsib-').
BREVO_API_KEY=xkeysib-your_brevo_v3_api_key_here

# Verified Sender Identity
# NOTE: In Brevo, this sender email MUST be verified under Senders & IP in your Brevo dashboard.
MAIL_FROM=Hostel Management System <verified-sender@yourdomain.com>
MAIL_FROM_NAME="Hostel Management System"

# Standard SMTP Fallback (Optional - for local dev or platforms with open SMTP ports)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
