# ==============================================================================
# Hostel Management System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real configuration.
# DO NOT COMMIT YOUR REAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development
PORT=5000

# MongoDB Database Connection String
# Local: mongodb://127.0.0.1:27017/hostel_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hostel_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hostel_management_system?retryWrites=true&w=majority

# JWT (JSON Web Token) Security Settings
# Generate a cryptographically secure key: openssl rand -base64 32
JWT_SECRET=your_32_character_minimum_random_secret_string_here
JWT_EXPIRE=30d

# Frontend & Application URLs (Used for CORS and email reset/verification links)
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Student Email Verification Policy
# Set to 'false' during initial local dev/testing; set to 'true' in staging/production
REQUIRE_EMAIL_VERIFICATION=false

# ==============================================================================
# Email Delivery Configuration
# ==============================================================================
# Supported EMAIL_PROVIDER options:
# 1. 'ethereal' - Automatic zero-config mock SMTP for local development (default fallback)
# 2. 'smtp'     - Standard SMTP (e.g. Gmail App Password, Mailtrap, custom server)
# 3. 'brevo'    - Brevo (formerly Sendinblue) transactional relay
EMAIL_PROVIDER=smtp

# SMTP Credentials (Required when EMAIL_PROVIDER=smtp or brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_or_api_key_here

# Sender Identity
MAIL_FROM=Hostel Management System <noreply@your-verified-domain.com>
MAIL_FROM_NAME="Hostel Management System"
